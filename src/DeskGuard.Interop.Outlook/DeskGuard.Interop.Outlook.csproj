<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>DeskGuard.Interop.Outlook</RootNamespace>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1003">
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </PackageReference>
    <PackageReference Include="MicrosoftOfficeCore" Version="15.0.0" />
    <PackageReference Include="stdole" Version="17.14.40260" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskGuard.Core\DeskGuard.Core.csproj" />
    <ProjectReference Include="..\DeskGuard.Data\DeskGuard.Data.csproj" />
  </ItemGroup>

</Project>
